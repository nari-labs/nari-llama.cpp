#version 450

// Adds the k-split partial sums of a Trellis product (slices 1 .. splits - 1 of y) into slice 0.
layout(local_size_x = 64) in;
layout(binding = 0) buffer Values { float y[]; };

layout(push_constant) uniform Parameters {
    uint splits;
    uint n;
    uint batch;
    uint unused;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint size = p.n * p.batch;
    if (i >= size) {
        return;
    }
    float sum = y[i];
    for (uint s = 1; s < p.splits; ++s) {
        sum += y[s * size + i];
    }
    y[i] = sum;
}
